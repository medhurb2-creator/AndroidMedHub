{
  "appId": "com.medhurb.app",
  "appName": "MedVix",
  "webDir": "dist",

  "server": {
    "androidScheme": "https"
  },

  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },

  "plugins": {
    "SocialLogin": {
      "providers": {
        "google": true
      },
      "logLevel": 1
    }
  }
}