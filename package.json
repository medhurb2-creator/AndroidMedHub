{
  "name": "medvix",
  "version": "1.0.0",
  "description": "Medical exam preparation PWA with Convex backend integration",
  "type": "module",
  "scripts": {
    "sync-wasm": "node scripts/tools/sync-wasm.mjs",
    "predev": "npm run sync-wasm",
    "dev": "vite",
    "prebuild": "npm run sync-wasm",
    "build": "vite build && node scripts/obfuscate-dist.mjs && node scripts/encrypt-json.js && npx cap sync android && git add .",
    "preview": "vite preview",
    "sync": "npx cap sync android",
    "open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/device": "8.0.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-printer": "^8.1.4",
    "@capgo/capacitor-social-login": "^8.5.11",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "convex": "^1.32.0",
    "css-tree": "^3.2.1",
    "parse5": "^8.0.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "glob": "^10.5.0",
    "javascript-obfuscator": "^5.5.0",
    "vite": "^6.4.3"
  }
}
